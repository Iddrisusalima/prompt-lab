<mxfile host="app.diagrams.net" type="device">
  <diagram id="prompt-lab-architecture" name="Prompt Lab architecture">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Prompt Lab - one turn, end to end" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Memory is not recall. The whole history is re-sent on every request, which is why cost climbs each turn." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="60" y="52" width="700" height="26" as="geometry" />
        </mxCell>

        <mxCell id="A" value="User types a message" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="B" value="Is it a command?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="C" value="&lt;b&gt;Handled locally&lt;/b&gt;&lt;br&gt;&lt;i&gt;no API call, no cost&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="700" y="215" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="D" value="Append to history&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;role = user&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="E" value="&lt;b&gt;Build request&lt;/b&gt;&lt;br&gt;system_instruction&lt;br&gt;+ &lt;b&gt;ENTIRE history&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="Enote" value="This is the whole trick.&#10;The model is stateless, so&#10;the full transcript goes&#10;on every single request." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#856404" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="F" value="Gemini API" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="320" y="550" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="G" value="&lt;font face=&quot;Courier New&quot;&gt;history.pop()&lt;/font&gt; rolls back&lt;br&gt;&lt;br&gt;Explain by HTTP code:&lt;br&gt;401 key / 404 model&lt;br&gt;429 quota / 5xx theirs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="700" y="630" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="Gnote" value="Nothing is added to history,&#10;so a failed request cannot&#10;corrupt the next one." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="700" y="750" width="230" height="56" as="geometry" />
        </mxCell>

        <mxCell id="H" value="Reply text&lt;br&gt;+ &lt;font face=&quot;Courier New&quot;&gt;usage_metadata&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="320" y="655" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="I" value="Append to history&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;role = model&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="320" y="755" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="J" value="&lt;font face=&quot;Courier New&quot;&gt;cost_of(input, output)&lt;/font&gt;&lt;br&gt;Update session totals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="320" y="855" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="K" value="Print reply, tokens&lt;br&gt;and cost for this turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="320" y="955" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eAB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666" edge="1" parent="1" source="A" target="B">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eBC" value="/reset  /stats  /persona&#10;/stream  /help" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;fontSize=10" edge="1" parent="1" source="B" target="C">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eCA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;strokeColor=#666666;dashed=1" edge="1" parent="1" source="C" target="A">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="815" y="135" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eBD" value="normal message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;fontSize=10" edge="1" parent="1" source="B" target="D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eDE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666" edge="1" parent="1" source="D" target="E">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eEF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666" edge="1" parent="1" source="E" target="F">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eFG" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;fontSize=10;fontColor=#b85450" edge="1" parent="1" source="F" target="G">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="575" />
              <mxPoint x="620" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eGA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#b85450;dashed=1" edge="1" parent="1" source="G" target="A">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="685" />
              <mxPoint x="1000" y="135" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eFH" value="success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;fontSize=10;fontColor=#82b366" edge="1" parent="1" source="F" target="H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eHI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666" edge="1" parent="1" source="H" target="I">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eIJ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666" edge="1" parent="1" source="I" target="J">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eJK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666" edge="1" parent="1" source="J" target="K">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eKA" value="history is now longer, so&#10;the next turn costs more" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#666666;dashed=1;fontSize=10" edge="1" parent="1" source="K" target="A">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="985" />
              <mxPoint x="190" y="135" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
