# Copy this file to .env and fill in your real key.
# .env is git-ignored, this example file is safe to commit.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Which model to talk to. Change this any time.
# Cheapest option with transparent token accounting (no hidden thinking tokens).
GEMINI_MODEL=gemini-3.5-flash-lite
